{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracking Plan",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_name", "trigger", "properties"],
        "properties": {
          "event_name": { "type": "string" },
          "trigger": { "type": "string" },
          "properties": { "type": "array", "items": { "type": "object" } },
          "privacy_level": { "type": "string" }
        }
      }
    }
  }
}
