{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product OKR",
  "type": "object",
  "required": ["period", "objectives"],
  "properties": {
    "period": { "type": "string" },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective", "key_results"],
        "properties": {
          "objective": { "type": "string" },
          "key_results": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
