{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/pm/prd.schema.min.json",
  "title": "PRD minimal contract",
  "type": "object",
  "required": ["prd_id", "version", "status", "features", "pages", "entities", "user_flows", "traceability"],
  "properties": {
    "prd_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "in_review", "approved", "released"] },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "name", "priority", "acceptance_criteria"],
        "properties": {
          "feature_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
          "related_pages": { "type": "array", "items": { "type": "string" } },
          "related_entities": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "minItems": 1 }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id", "name", "route"],
        "properties": {
          "page_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "name", "fields"],
        "properties": {
          "entity_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "fields": { "type": "array" }
        }
      }
    },
    "user_flows": { "type": "array" },
    "traceability": { "type": "array" }
  }
}
