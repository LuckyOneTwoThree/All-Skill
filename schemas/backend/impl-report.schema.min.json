{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/backend/impl-report.schema.min.json",
  "title": "Backend implementation report minimal contract",
  "type": "object",
  "required": ["skill_name", "version", "generated_files", "alignment_check", "self_audit"],
  "properties": {
    "skill_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "generated_files": { "type": "array" },
    "alignment_check": { "type": "object" },
    "self_audit": {
      "type": "object",
      "required": ["p0_count", "passed"],
      "properties": {
        "p0_count": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
