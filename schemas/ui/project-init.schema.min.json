{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/ui/project-init.schema.min.json",
  "title": "UI project-init minimal contract",
  "type": "object",
  "required": ["visual_direction", "tokens", "component_library", "scaffold", "project_dir"],
  "properties": {
    "visual_direction": {
      "type": "object",
      "required": ["aesthetic_direction", "color_strategy", "theme_decision", "visual_policy"],
      "properties": {
        "aesthetic_direction": { "type": "string", "minLength": 1 },
        "color_strategy": { "type": "string" },
        "theme_decision": { "type": "string" },
        "visual_policy": {
          "type": "string",
          "enum": ["existing-design-system-first", "balanced", "differentiation-strict"]
        }
      }
    },
    "tokens": { "type": "object" },
    "component_library": { "type": "object" },
    "scaffold": { "type": "object" },
    "project_dir": { "type": "string", "minLength": 1 }
  }
}
