{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/ui/pages.schema.min.json",
  "title": "UI pages minimal contract",
  "type": "object",
  "required": ["pages", "components", "quality_report", "project_dir"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "route", "component_tree"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "minLength": 1 },
          "component_tree": { "type": "array" },
          "data_flow": { "type": "array" }
        }
      }
    },
    "components": { "type": "array" },
    "quality_report": {
      "type": "object",
      "required": ["p0_issues"],
      "properties": {
        "p0_issues": { "type": "array" },
        "pass_rate": { "type": "number" }
      }
    },
    "project_dir": { "type": "string", "minLength": 1 }
  }
}
