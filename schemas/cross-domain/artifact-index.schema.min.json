{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/cross-domain/artifact-index.schema.min.json",
  "title": "Cross-domain artifact index minimal contract",
  "type": "object",
  "required": ["orchestrator", "artifacts"],
  "properties": {
    "orchestrator": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "skill", "paths", "status"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["pending", "passed", "failed", "degraded"] },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
