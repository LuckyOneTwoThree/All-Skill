{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-skill.local/schemas/cross-domain/approval.schema.min.json",
  "title": "Human approval minimal contract",
  "type": "object",
  "required": ["approval_id", "stage", "decision_required", "options", "status"],
  "properties": {
    "approval_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "decision_required": { "type": "string", "minLength": 1 },
    "recommended_option": { "type": "string" },
    "options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "risks": { "type": "array" },
    "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "decided_by": { "type": "string" },
    "decided_at": { "type": "string" }
  }
}
